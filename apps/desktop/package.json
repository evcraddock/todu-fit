{
  "name": "todu-fit-desktop",
  "version": "0.1.1",
  "private": true,
  "description": "Todu Fit shared daemon desktop client",
  "author": "Todu",
  "main": "electron/main.cjs",
  "scripts": {
    "build:native": "node scripts/build-native.cjs",
    "build": "npm run build:daemon && tsc --noEmit && vite build",
    "package": "npm run build && electron-builder --dir",
    "package:installer": "npm run build && electron-builder",
    "test": "node --test tests/daemon.cjs tests/startup.cjs",
    "test:packaged": "node tests/packaged.cjs && node tests/packaged-setup.cjs",
    "build:daemon": "node scripts/build-daemon.cjs",
    "test:native-proof": "node --test tests/native.cjs"
  },
  "build": {
    "appId": "com.todu.fit.proof",
    "productName": "Todu Fit Proof",
    "directories": {
      "output": "out"
    },
    "files": [
      "electron/**",
      "dist/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "daemon",
        "to": "daemon",
        "filter": [
          "fit",
          "fit.exe"
        ]
      }
    ],
    "artifactName": "todu-fit-desktop-${version}-${os}-${arch}.${ext}",
    "linux": {
      "target": "AppImage",
      "category": "Utility"
    },
    "mac": {
      "target": "dmg",
      "forceCodeSigning": true,
      "hardenedRuntime": true,
      "binaries": [
        "Contents/Resources/daemon/fit"
      ],
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "Todu Fit uses its background daemon to sync your nutrition data with your configured server on the local network."
      }
    },
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "afterSign": "scripts/verify-mac-signing.cjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "45.2.2",
    "electron-builder": "26.18.0",
    "playwright": "1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
